{
  "schema": "1.0",
  "comment": "This file maps proto services/RPCs to the corresponding library clients/methods",
  "language": "java",
  "protoPackage": "google.shopping.merchant.reviews.v1",
  "libraryPackage": "com.google.shopping.merchant.reviews.v1",
  "services": {
    "ProductReviewsService": {
      "clients": {
        "grpc": {
          "libraryClient": "ProductReviewsServiceClient",
          "rpcs": {
            "DeleteProductReview": {
              "methods": ["deleteProductReview", "deleteProductReview", "deleteProductReview", "deleteProductReviewCallable"]
            },
            "GetProductReview": {
              "methods": ["getProductReview", "getProductReview", "getProductReview", "getProductReviewCallable"]
            },
            "InsertProductReview": {
              "methods": ["insertProductReview", "insertProductReviewCallable"]
            },
            "ListProductReviews": {
              "methods": ["listProductReviews", "listProductReviews", "listProductReviews", "listProductReviewsPagedCallable", "listProductReviewsCallable"]
            }
          }
        }
      }
    }
  }
}